{
  "name": "bazarflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @bazarflow/web",
    "build": "npm run build -w @bazarflow/web",
    "typecheck": "npm run typecheck -w @bazarflow/web",
    "lint": "npm run lint -w @bazarflow/web",
    "test": "npm run test -w @bazarflow/web",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": { "node": ">=20" }
}
