# Copy to .env.local. Placeholders only — never commit real secrets.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=bazarflow
# >= 32 chars each; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-me-with-at-least-32-random-characters
JWT_ISSUER=bazarflow
JWT_AUDIENCE=bazarflow-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Payments: provider id (mock | sslcommerz) and mode (sandbox | live)
PAYMENT_PROVIDER=mock
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=replace-me-with-at-least-32-random-characters
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Cloudinary (server side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Reservation / checkout
STOCK_RESERVATION_TTL_MINUTES=30
# Platform commission in basis points (1000 = 10.00%) — default policy v1
DEFAULT_COMMISSION_BPS=1000
# Cash on delivery (true only when operations can collect and reconcile cash)
COD_ENABLED=false
# Cash-on-delivery guard rails (minor units; see docs/16 section 10)
# COD_MAX_ORDER_MINOR=3000000
# COD_MAX_OPEN_ORDERS=3
# COD_BLOCK_AFTER_FAILURES=2

# Shared secret for the scheduled worker endpoint /api/internal/worker (also a GitHub secret). Unset = endpoint disabled.
# CRON_SECRET=
# Error reporting (Sentry or compatible). Unset = errors are only logged.
# SENTRY_DSN=
REFUND_MAKER_CHECKER_MINOR=500000
PAYMENT_RECONCILE_AFTER_MINUTES=10
PAYOUT_HOLD_DAYS=7
RETURN_WINDOW_DAYS=7
PAYOUT_MAKER_CHECKER_MINOR=1000000
MIN_PAYOUT_MINOR=50000
# Fake hosted payment page for demos (needs PAYMENT_PROVIDER=mock; always allowed outside production)
MOCK_PAYMENT_UI=false

# Help assistant (feature-flagged). none = answers extracted from approved help content, no model involved.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=none
AI_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
SUPPORT_CONTACT=support@bazarflow.example
SUPPORT_LOG_QUESTIONS=false

# Email (SMTP) and push (FCM). Unset = not sent; the in-app inbox still works.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="BazarFlow <no-reply@bazarflow.example>"
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Social sign-in via Firebase Auth (Google / Apple / Facebook). Leave unset to hide the buttons.
# Firebase console -> Project settings -> General -> Your apps -> Web app. These web values are public, not secrets.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_WEB_API_KEY=AIza...
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_WEB_APP_ID=1:1234567890:web:abcdef
# FIREBASE_SIGN_IN_PROVIDERS=google.com,apple.com,facebook.com
