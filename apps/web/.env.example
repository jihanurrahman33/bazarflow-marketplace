# Copy to .env.local. Placeholders only — never commit real secrets.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=bazarflow
# >= 32 chars each; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-me-with-at-least-32-random-characters
JWT_ISSUER=bazarflow
JWT_AUDIENCE=bazarflow-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Payments: provider id (mock | sslcommerz) and mode (sandbox | live)
PAYMENT_PROVIDER=mock
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=replace-me-with-at-least-32-random-characters
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Cloudinary (server side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Reservation / checkout
STOCK_RESERVATION_TTL_MINUTES=30
# Platform commission in basis points (1000 = 10.00%) — default policy v1
DEFAULT_COMMISSION_BPS=1000
# Cash on delivery (true only when operations can collect and reconcile cash)
COD_ENABLED=false
REFUND_MAKER_CHECKER_MINOR=500000
PAYMENT_RECONCILE_AFTER_MINUTES=10
PAYOUT_HOLD_DAYS=7
RETURN_WINDOW_DAYS=7
PAYOUT_MAKER_CHECKER_MINOR=1000000
MIN_PAYOUT_MINOR=50000
# Fake hosted payment page for demos (needs PAYMENT_PROVIDER=mock; always allowed outside production)
MOCK_PAYMENT_UI=false

# Help assistant (feature-flagged). none = answers extracted from approved help content, no model involved.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=none
AI_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
SUPPORT_CONTACT=support@bazarflow.example
SUPPORT_LOG_QUESTIONS=false
